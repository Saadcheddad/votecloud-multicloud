# FaaS #1 - AWS Lambda (faas-vote)
# En production sur AWS Lambda, configurez ces variables dans :
# AWS Console -> Lambda -> votecloud-faas-vote -> Configuration -> Environment variables

# PaaS #1 - Supabase PostgreSQL (Session/Transaction Pooler IPv4)
DATABASE_URL=postgresql://postgres.VOTRE_REF:VOTRE_MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
DATABASE_SSL=true

# Secrets cryptographiques identiques à GCP IaaS #1 et AWS EC2 IaaS #2
JWT_SECRET=dev-jwt-secret-change-me-in-production-64chars
AUDIT_WEBHOOK_SECRET=dev-audit-webhook-secret-change-me-in-production-64chars

# URL du nœud d'audit (IaaS #2 - AWS EC2)
AUDIT_SERVICE_URL=http://localhost:3002

# Pour exécution locale uniquement
PORT=3003
AWS_REGION=eu-west-3
