# FaaS #1 - Vercel Serverless Functions (faas-vote)
# Configurer ces variables dans : Vercel Dashboard -> Settings -> Environment Variables

# PaaS #1 - Supabase PostgreSQL (Session Pooler IPv4)
DATABASE_URL=postgresql://postgres.VOTRE_REF:VOTRE_MOT_DE_PASSE@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=true

# Secrets cryptographiques identiques à OCI IaaS #1 et OCI IaaS #2
JWT_SECRET=dev-jwt-secret-change-me-in-production-64chars
AUDIT_WEBHOOK_SECRET=dev-audit-webhook-secret-change-me-in-production-64chars

# URL du nœud d'audit (IaaS #2 - Oracle Cloud OCI VM #2)
AUDIT_SERVICE_URL=http://localhost:3002

# Pour exécution locale uniquement
PORT=3003
