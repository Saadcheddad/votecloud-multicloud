# PaaS #2 - Render Web Service (frontend + passerelle BFF HTTPS)
PORT=3000
NODE_ENV=production
CLOUD_PROVIDER=Render
CLOUD_SERVICE=Render Web Service (PaaS #2)
CLOUD_REGION=frankfurt

# URLs des services distants (à configurer dans Render -> Environment Variables)
# IaaS #1 : GCP Compute Engine (ex: http://34.120.10.5)
AUTH_SERVICE_URL=http://localhost:3001

# IaaS #2 : AWS EC2 Audit Node (ex: http://13.38.20.9)
AUDIT_SERVICE_URL=http://localhost:3002

# FaaS #1 : AWS Lambda Function URL HTTPS (ex: https://xxxx.lambda-url.eu-west-3.on.aws)
FAAS_VOTE_URL=http://localhost:3003
