# IaaS #1 - GCP Compute Engine (backend-auth)
PORT=3001
NODE_ENV=production
CLOUD_PROVIDER=Google Cloud Platform (GCP)
CLOUD_SERVICE=Compute Engine e2-micro (IaaS #1)
CLOUD_REGION=us-central1-a

# PaaS #1 - Supabase PostgreSQL (Session Pooler IPv4)
DATABASE_URL=postgresql://postgres.VOTRE_REF:VOTRE_MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
DATABASE_SSL=true

# Secrets cryptographiques partagés inter-cloud
JWT_SECRET=dev-jwt-secret-change-me-in-production-64chars
VOTE_HMAC_SECRET=dev-vote-hmac-secret-change-me-in-production-64chars
AUDIT_WEBHOOK_SECRET=dev-audit-webhook-secret-change-me-in-production-64chars

# URL du nœud d'audit (IaaS #2 - AWS EC2)
AUDIT_SERVICE_URL=http://localhost:3002

# Origines autorisées CORS (séparées par virgules ou *)
CORS_ORIGIN=*
