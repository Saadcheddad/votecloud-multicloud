# IaaS #2 - Oracle Cloud Infrastructure OCI VM #2 (backend-audit)
PORT=3002
NODE_ENV=production
CLOUD_PROVIDER=Oracle Cloud Infrastructure (OCI)
CLOUD_SERVICE=OCI Compute Audit Node (IaaS #2)
CLOUD_REGION=af-casablanca-1

# PaaS #1 - Supabase PostgreSQL (Session Pooler IPv4)
DATABASE_URL=postgresql://postgres.VOTRE_REF:VOTRE_MOT_DE_PASSE@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=true

# Secret HMAC partagé avec OCI IaaS #1 et Vercel FaaS #1
AUDIT_WEBHOOK_SECRET=dev-audit-webhook-secret-change-me-in-production-64chars

# Chemin du registre local immuable sur le volume persistant OCI
AUDIT_LEDGER_PATH=/var/lib/votecloud/audit-chain.jsonl

CORS_ORIGIN=*
