# IaaS #2 - AWS EC2 (backend-audit)
PORT=3002
NODE_ENV=production
CLOUD_PROVIDER=Amazon Web Services (AWS)
CLOUD_SERVICE=Amazon EC2 t3.micro (IaaS #2)
CLOUD_REGION=eu-west-3

# PaaS #1 - Supabase PostgreSQL (Session Pooler IPv4)
DATABASE_URL=postgresql://postgres.VOTRE_REF:VOTRE_MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
DATABASE_SSL=true

# Secret HMAC partagé avec GCP IaaS #1 et AWS Lambda FaaS #1
AUDIT_WEBHOOK_SECRET=dev-audit-webhook-secret-change-me-in-production-64chars

# Chemin du registre local immuable sur le volume EBS d'AWS EC2
AUDIT_LEDGER_PATH=./data/audit-chain.jsonl

CORS_ORIGIN=*
