# ==============================================================================
# VoteCloud - Variables d'environnement globales (Exemple)
# Architecture Multicloud : 2 IaaS (OCI x2) + 2 PaaS (Supabase + Render) + 1 FaaS (Vercel)
# NE JAMAIS commiter le fichier .env dans Git !
# ==============================================================================

# --- PaaS #1 : Supabase PostgreSQL 17 (Session Pooler IPv4 port 5432) ---
DATABASE_URL=postgresql://postgres.VOTRE_REF:VOTRE_MOT_DE_PASSE@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=true

# --- Secrets cryptographiques partagés inter-cloud (générer avec: openssl rand -hex 32) ---
JWT_SECRET=REMPLACER_PAR_SECRET_ALEATOIRE_64_HEX_CHARS_MIN_JWT
VOTE_HMAC_SECRET=REMPLACER_PAR_SECRET_ALEATOIRE_64_HEX_CHARS_MIN_HMAC
AUDIT_WEBHOOK_SECRET=REMPLACER_PAR_SECRET_ALEATOIRE_64_HEX_CHARS_MIN_AUDIT

# --- URLs inter-cloud ---
# IaaS #1 : Oracle Cloud OCI VM #1 (backend-auth)
AUTH_SERVICE_URL=http://localhost:3001

# IaaS #2 : Oracle Cloud OCI VM #2 (backend-audit)
AUDIT_SERVICE_URL=http://localhost:3002

# FaaS #1 : Vercel Serverless Functions (faas-vote)
FAAS_VOTE_URL=http://localhost:3003

# PaaS #2 : Render Web Service (frontend)
FRONTEND_URL=http://localhost:3000

# --- Métadonnées d'affichage Cloud ---
OCI_CLOUD_REGION=af-casablanca-1
RENDER_REGION=frankfurt
SUPABASE_REGION=eu-west-1
VERCEL_REGION=cdg1
