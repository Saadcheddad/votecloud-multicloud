# ==============================================================================
# VoteCloud - Variables d'environnement globales (Exemple)
# Copier ce fichier vers .env et remplacer les valeurs par vos secrets réels
# NE JAMAIS commiter le fichier .env dans Git !
# ==============================================================================

# --- PaaS #1 : Supabase PostgreSQL (Utiliser l'URL "Session Pooler" IPv4 port 5432) ---
DATABASE_URL=postgresql://postgres.VOTRE_REF:VOTRE_MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
DATABASE_SSL=true

# --- Secrets cryptographiques partagés inter-cloud (générer avec: openssl rand -hex 32) ---
JWT_SECRET=REMPLACER_PAR_SECRET_ALEATOIRE_64_HEX_CHARS_MIN_JWT
VOTE_HMAC_SECRET=REMPLACER_PAR_SECRET_ALEATOIRE_64_HEX_CHARS_MIN_HMAC
AUDIT_WEBHOOK_SECRET=REMPLACER_PAR_SECRET_ALEATOIRE_64_HEX_CHARS_MIN_AUDIT

# --- URLs inter-cloud (remplir au fur et à mesure du déploiement) ---
# IaaS #1 : GCP Compute Engine (ex: http://34.120.10.5)
AUTH_SERVICE_URL=http://localhost:3001

# IaaS #2 : AWS EC2 Audit Node (ex: http://13.38.20.9)
AUDIT_SERVICE_URL=http://localhost:3002

# FaaS #1 : AWS Lambda Function URL HTTPS (ex: https://xxxx.lambda-url.eu-west-3.on.aws)
FAAS_VOTE_URL=http://localhost:3003

# PaaS #2 : Render Frontend URL (ex: https://votecloud-frontend.onrender.com)
FRONTEND_URL=http://localhost:3000

# --- Métadonnées d'affichage Cloud (pour le tableau de bord temps réel) ---
GCP_CLOUD_REGION=us-central1-a
AWS_EC2_REGION=eu-west-3
AWS_LAMBDA_REGION=eu-west-3
RENDER_REGION=frankfurt
SUPABASE_REGION=eu-west-3
